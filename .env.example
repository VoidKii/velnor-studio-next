# Optional public catalog lookup through the YouTube Data API v3.
# Keep this key server-side. Restrict it to YouTube Data API v3 in Google Cloud.
YOUTUBE_API_KEY=

# Optional AI idea drafting through the OpenAI Responses API. Leave blank for
# the free local idea framework. This key is read by server routes only.
OPENAI_API_KEY=
# Optional model override. Defaults to gpt-6-astra when omitted.
OPENAI_IDEA_MODEL=

# Optional cloud persistence/auth in a future stage. The MVP uses local browser storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
