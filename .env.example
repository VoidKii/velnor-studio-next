# Optional public catalog lookup through the YouTube Data API v3.
# Keep this key server-side. Restrict it to YouTube Data API v3 in Google Cloud.
YOUTUBE_API_KEY=

# Optional owner-authorized YouTube connection. Keep every value server-side.
# Configure a Google OAuth web client and register this exact callback URI:
# http://localhost:3000/api/youtube/oauth/callback (local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
# Generate a private 32-byte random key; do not commit the generated value.
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Optional AI idea drafting through the OpenAI Responses API. Leave blank for
# the free local idea framework. This key is read by server routes only.
OPENAI_API_KEY=
# Optional model override. Defaults to gpt-6-astra when omitted.
OPENAI_IDEA_MODEL=

# Optional cloud persistence/auth in a future stage. The MVP uses local browser storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
